{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "g++ 编译当前文件夹项目",
            "command": "$cpp = Get-ChildItem -Path '${fileDirname}' -Filter *.cpp | ForEach-Object { $_.FullName }; & 'g++.exe' $cpp -o '${fileDirname}\\app.exe' -g -Wall -Wextra -std=c++17",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译并链接当前文件夹内所有 cpp"
        },
        {
            "type": "cppbuild",
            "label": "g++ 编译当前文件",
            "command": "g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-Wall",
                "-Wextra",
                "-std=c++17",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "只编译当前 cpp 文件"
        }
    ]
}